#!/bin/sh
# scripts/git-hooks/pre-commit – Pre-Commit Gate für Secrets, .env und Linting
#
# Dieser Hook schützt das Repository vor versehentlichen Datenlecks und Lint-Fehlern:
# 1. Gate: Blockiert gestagte .env-Dateien (.env, .env.local, .env.* - außer .env.example)
# 2. Gate: Blockiert echte API-Keys, Private Keys und Secrets im gestagten Diff (via core/secret_scanner.py)
# 3. Gate: Führt ruff check auf allen gestagten Python-Dateien aus
#
# Installation:
#   powershell -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1 (Windows)
#   bash scripts/install-git-hooks.sh                                      (Linux/macOS)

# -------------------------------------------------------------
# 1. & 2. Gate: .env-Dateien und API-Keys / Secrets blockieren
# -------------------------------------------------------------
PYTHON_CMD=""
if command -v python >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
elif command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py"
fi

if [ -n "$PYTHON_CMD" ]; then
    $PYTHON_CMD scripts/git-hooks/check_secrets.py
    secret_status=$?
    if [ $secret_status -ne 0 ]; then
        exit 1
    fi
else
    # Fallback-Prüfung ohne Python für gestagte .env-Dateien
    staged_env=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\..*)' | grep -v '\.env\.example$')
    if [ -n "$staged_env" ]; then
        echo ""
        echo "❌ Commit abgebrochen: Gestagte .env-Datei(en) gefunden:"
        echo "$staged_env"
        echo "   Echte Secrets dürfen NIEMALS committet werden! Verwende stattdessen .env.example."
        echo ""
        exit 1
    fi
fi

# -------------------------------------------------------------
# 3. Gate: ruff check (gestagte Python-Dateien)
# -------------------------------------------------------------
if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')" ]; then
    exit 0
fi

if ! command -v ruff >/dev/null 2>&1; then
    echo "⚠️  ruff nicht gefunden (pip install -r requirements-dev.txt) – Pre-Commit-Lint-Gate übersprungen."
    exit 0
fi

echo "🧹 Pre-Commit-Lint-Gate: ruff check (gestagte Python-Dateien) ..."
git diff --cached --name-only -z --diff-filter=ACMR -- '*.py' | xargs -0 ruff check --force-exclude --
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "❌ Commit abgebrochen: ruff hat Lint-Fehler in gestagten Dateien gefunden (siehe oben)."
    echo "   Viele lassen sich automatisch beheben: ruff check <datei> --fix"
    echo "   Absichtlich trotzdem committen: git commit --no-verify"
    exit 1
fi

exit 0
