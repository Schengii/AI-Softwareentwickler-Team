#!/bin/sh
# scripts/git-hooks/pre-commit – lokales Lint-Gate vor jedem Commit
#
# Realer Fund: main.py/agents/orchestrator.py & Co. landeten mehrfach mit Lint-Fehlern
# (ungenutzte Imports, ein echter F821-Undefined-Name-Bug) auf `main`, weil `ruff check .`
# nirgends VOR dem Commit lief - erst der CI-Lint-Job in der Cloud fing es auf, nachdem der
# rote Stand bereits gepusht war. Dieser Hook holt genau diese Prüfung lokal nach vorne,
# ohne einen neuen Python-Paketmanager oder das `pre-commit`-Framework einzuführen - nur
# `ruff` (ohnehin in requirements-dev.txt), dieselbe ruff.toml wie CI.
#
# Installation (einmalig, siehe scripts/install-git-hooks.ps1 bzw. .sh):
#   Kopiert diese Datei nach .git/hooks/pre-commit (Git versioniert .git/hooks/ selbst nicht,
#   deshalb liegt das Original hier im normal versionierten scripts/-Verzeichnis).
#
# Bewusst NUR ein Gate, kein automatischer Fix: ein Commit, der sich lautlos selbst verändert,
# wäre überraschender als ein abgebrochener Commit mit klarer Fehlermeldung.

#
# Realer Fund (Framework-Analyse 2026-09-10, Backlog-Tickets cli-9b95ab3e/cli-034e08e5): das
# Gate prüfte mit `ruff check .` das GANZE Repository. Eine nicht gestagte Notizdatei
# (scratch/test_keys.py) oder eine gerade parallel bearbeitete Framework-Datei blockierte
# dadurch Commits, die diese Dateien gar nicht enthielten. Geprüft werden jetzt nur die
# gestagten Python-Dateien; --force-exclude hält die Excludes aus ruff.toml auch für explizit
# übergebene Pfade ein. -z/xargs -0 macht das robust gegen Leerzeichen in Dateinamen.

if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')" ]; then
    exit 0
fi

if ! command -v ruff >/dev/null 2>&1; then
    echo "⚠️  ruff nicht gefunden (pip install -r requirements-dev.txt) – Pre-Commit-Lint-Gate übersprungen."
    exit 0
fi

echo "🧹 Pre-Commit-Lint-Gate: ruff check (gestagte Python-Dateien) ..."
git diff --cached --name-only -z --diff-filter=ACMR -- '*.py' | xargs -0 ruff check --force-exclude --
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "❌ Commit abgebrochen: ruff hat Lint-Fehler in gestagten Dateien gefunden (siehe oben)."
    echo "   Viele lassen sich automatisch beheben: ruff check <datei> --fix"
    echo "   Absichtlich trotzdem committen: git commit --no-verify"
    exit 1
fi

exit 0
