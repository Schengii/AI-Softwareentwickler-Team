# Application & Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
WORKER_CONCURRENCY=4

# Security & Multi-Tenant HMAC
SECRET_KEY=generate_a_secure_random_32_byte_hex_key_here
HMAC_ALGORITHM=sha256

# Persistence (SQLite Async via aiosqlite)
DATABASE_URL=sqlite+aiosqlite:////app/data/omniqueue.db

# Queue & Resilienz
RING_BUFFER_SIZE=1000
DEFAULT_MAX_RETRIES=5
EXPONENTIAL_BACKOFF_FACTOR=2.0
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30

# DSGVO Retention (Tage)
EVENT_RETENTION_DAYS=30
