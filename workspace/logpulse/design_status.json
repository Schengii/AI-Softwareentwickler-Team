{
  "project": "Logpulse",
  "theme": "Dark Mode",
  "design_system": {
    "colors": {
      "bg-primary": "#0f172a",
      "bg-secondary": "#1e293b",
      "text-primary": "#f8fafc",
      "text-secondary": "#94a3b8",
      "accent": "#38bdf8",
      "error": "#ef4444",
      "warning": "#f59e0b",
      "info": "#3b82f6"
    },
    "typography": {
      "font": "Inter, sans-serif"
    }
  },
  "assets": {
    "logo": "/assets/design/logo.svg",
    "icons": {
      "info": "/assets/design/icons/info.svg",
      "warning": "/assets/design/icons/warning.svg",
      "error": "/assets/design/icons/error.svg",
      "critical": "/assets/design/icons/critical.svg"
    }
  },
  "layout": {
    "sidebar": "w-64 bg-secondary border-r border-slate-700",
    "main": "flex-1 bg-primary p-6",
    "grid": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
  }
