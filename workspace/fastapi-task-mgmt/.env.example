# Kopieren nach ".env" (bereits in .gitignore, wird nicht versioniert) und einen echten,
# zufälligen Wert eintragen, z.B. per:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Ohne gesetzten SECRET_KEY startet die App weiterhin (siehe auth.py), aber mit einem
# unsicheren, im Quellcode sichtbaren Entwicklungs-Platzhalter - niemals so deployen.
SECRET_KEY=
