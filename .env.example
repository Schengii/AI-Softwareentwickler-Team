# ============================================================
# KI-Softwareentwickler-Team – Umgebungsvariablen (Vorlage)
# ============================================================
# Kopiere diese Datei zu ".env" und trage deine echten Keys ein:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (PowerShell)
# ".env" ist bereits in .gitignore und wird NIE committet.
#
# Minimal-Setup: NUR GEMINI_API_KEY eintragen reicht, um das Team komplett
# lauffähig zu machen (Gemini hat einen dauerhaften Gratis-Tarif). Alle
# weiteren Keys sind optional und erweitern nur die Modell-Auswahl bzw.
# das Fallback-Verhalten (core/llm_factory.py) – ohne sie fällt das Team
# automatisch auf Gemini zurück.

# ── Pflicht für den Betrieb ──────────────────────────────────
# Google Gemini API Key (kostenloser Tarif via https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ── Optional: erweitert Modell-Auswahl & Fallback-Kette ──────
# Anthropic Claude – KEIN dauerhafter Gratis-Tarif. Fehlt dieser Key, laufen
# alle "Heavy"-Aufgaben (Architektur/Security/Review) automatisch über Groq
# (falls konfiguriert) oder Gemini statt Claude. Siehe config.py AGENT_MODELS.
ANTHROPIC_API_KEY=

# Groq (https://console.groq.com/keys) – echter Gratis-Tarif, starkes
# Open-Weight-Modell (openai/gpt-oss-120b), dient als kostenlose Heavy-
# Ausweichstufe, wenn kein ANTHROPIC_API_KEY vorhanden ist.
GROQ_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys) – Pay-as-you-go, sehr
# günstig. Nur relevant, wenn du einzelne Agenten manuell darauf umstellst
# (siehe die *_MODEL-Variablen weiter unten).
DEEPSEEK_API_KEY=

# Tavily (https://tavily.com) – Live-Web-Recherche für den web_research-Agenten.
TAVILY_API_KEY=

# OpenRouter (https://openrouter.ai/keys) – Universal-Gateway, optionaler
# Zusatz-Fallback.
OPENROUTER_API_KEY=

# Hugging Face (https://huggingface.co/settings/tokens) – nur relevant für
# image_generator, falls du das auf ein echtes HF-Modell umstellst.
HUGGINGFACE_API_KEY=

# ============================================================
# Modell-Konfiguration
# ============================================================

# Hauptagent (Orchestrator) – bekommt bewusst das stärkste Modell (siehe
# README, Abschnitt "Echter agentischer Werkzeug-Loop").
ORCHESTRATOR_MODEL=claude-opus-5

# Standard-Modell für Agenten ohne explizite Rollen-Zuordnung
DEFAULT_AGENT_MODEL=gemini-3.6-flash

# Jede der 33 Spezialisten-Rollen (+ 5 Fachbereichsleiter) kann einzeln per
# <ROLLE>_MODEL überschrieben werden, z.B.:
#   BACKEND_MODEL=deepseek:deepseek-chat
#   TESTER_MODEL=groq:openai/gpt-oss-120b
# Vollständige Liste der Variablennamen und ihrer sinnvollen Standardwerte:
# siehe config.py (Abschnitt AGENT_MODELS).

# Sprache der Agenten-Antworten (de=Deutsch, en=Englisch)
AGENT_LANGUAGE=de

# ============================================================
# Lauf-Budget & Web-Dashboard-Sicherheit
# ============================================================

# Hartes Token-Limit pro Lauf (0 = deaktiviert). Empfehlung bei kostenpflichtigen
# Modellen (z.B. ANTHROPIC_API_KEY gesetzt): einen realistischen Wert setzen, damit
# ein außer Kontrolle geratener Lauf (viele Verifikations-Fixversuche) automatisch
# abbricht statt unbegrenzt weiter Tokens zu verbrauchen. Siehe config.py.
MAX_RUN_TOKENS=0

# Bind-Adresse des Web-Dashboards (python main.py --dashboard). Standard: nur lokal
# erreichbar. NUR ändern, wenn du bewusst Netzwerkzugriff willst – dann zusätzlich
# DASHBOARD_AUTH_TOKEN setzen, sonst verweigert das Dashboard den Start.
DASHBOARD_HOST=127.0.0.1

# Zugriffs-Token fürs Web-Dashboard. Leer = keine Auth nötig (nur sicher, solange
# DASHBOARD_HOST=127.0.0.1 bleibt). Gesetzt = jeder Request braucht den Header
# "Authorization: Bearer <token>" (oder "?token=<token>" in der URL).
DASHBOARD_AUTH_TOKEN=
